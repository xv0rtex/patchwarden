# Copia este fichero a .env y rellena lo que quieras usar (todo es opcional).
# Avisos y aprobaciones por Telegram (crea un bot con @BotFather; el chat id lo da @userinfobot)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Propuestas de corrección con Claude Code y tu plan de Claude, sin pagar API (sin esto solo hay avisos).
# Genéralo en tu equipo con: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=
# Acelera NVD (gratis en https://nvd.nist.gov/developers/request-an-api-key)
NVD_API_KEY=
# Token para los botones del panel (pon algo largo)
VIGILANTE_PANEL_TOKEN=cambia-esto-por-algo-largo
# URL desde la que abrirás el panel (para los enlaces de los avisos)
VIGILANTE_PANEL_URL=http://192.168.1.10:8080
